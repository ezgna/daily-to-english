{
  "expo": {
    "name": "Just Speak It",
    "slug": "just-speak-it",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "justspeakit",
    "locales": {
      "en": "./languages/en.json",
      "ja": "./languages/ja.json"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/app.icon",
      "bundleIdentifier": "com.ezgna.justspeakit",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.ezgna.justspeakit",
      "adaptiveIcon": {
        "backgroundColor": "#0088FF",
        "foregroundImage": "./assets/icons/android/foreground.png",
        "monochromeImage": "./assets/icons/android/monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "launcher"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Just Speak It to use your microphone for voice input.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
