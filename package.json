{
  "name": "just-speak-it",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "modules"
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && npm --workspaces --if-present run typecheck",
    "test": "npm --workspaces --if-present run test",
    "postinstall": "node scripts/patch-expo-cli.js",
    "db:types": "supabase gen types typescript --project-id wedhshxltbhxugnstsor > shared/supabase/database.types.ts",
    "functions:deploy": "supabase functions deploy api"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@just-speak-it/contract": "1.0.0",
    "@just-speak-it/core": "1.0.0",
    "@supabase/supabase-js": "^2.105.3",
    "@tanstack/react-query": "^5.90.12",
    "expo": "~57.0.9",
    "expo-asset": "~57.0.3",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.1.13"
  }
}
